# Copy to .env, select a local project, and supply your own credentials.
AGENT_WORKSPACE=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
OPENAI_THINKING=enabled
OPENAI_REASONING_EFFORT=high
AGENT_CONTEXT_WINDOW=1000000
RAG_API_URL=http://127.0.0.1:8000/api/rag
RAG_API_KEY=

# Optional host-reviewed chip relation graph; leave unset for ordinary retrieval.
# SPEC_RELATIONS_PATH=

# Dependency circuits (process-local, one state per model endpoint and per RAG
# operation). Thresholds are initial candidates, not tuned values: model 6 =
# one full retry budget, RAG 3 = three independent tool calls.
# CIRCUIT_BREAKER_DISABLED=false
# CIRCUIT_BREAKER_FAILURES=6
# CIRCUIT_BREAKER_RAG_FAILURES=3
# CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Optional local traces: install .[observability] and start infra/observability.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
# OTEL_EXPORTER_OTLP_TIMEOUT=2

# Optional structured operations log, collected by infra/monitoring/Alloy.
# MONITORING_LOG_PATH=../../output/service_logs/agent.jsonl
