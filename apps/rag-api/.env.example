# PostgreSQL：服务只允许目标数据库 rag_kb
RAG_DATABASE_URL=postgresql+psycopg://rag_user:change-me@127.0.0.1:5432/rag_kb

# Milvus：独立实例/collection
RAG_MILVUS_URI=http://127.0.0.1:19531
RAG_MILVUS_TOKEN=
RAG_MILVUS_COLLECTION=rag_specs
RAG_MILVUS_BATCH_SIZE=128
RAG_MILVUS_SEARCH_EF=64

# Embedding：切换 provider 前必须全量 reindex
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_FALLBACK=none

# DashScope / 可选 HuggingFace provider
RAG_DASHSCOPE_API_KEY=
RAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
RAG_HF_TOKEN=
RAG_HF_TIMEOUT_SECONDS=30
RAG_HF_MAX_RETRIES=3

# Rerank / generation
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=gte-rerank-v2
RAG_LLM_ENABLED=false
RAG_LLM_PROVIDER=deepseek
RAG_LLM_MODEL=deepseek-flash
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_API_KEY=
RAG_DEEPSEEK_THINKING=enabled
RAG_DEEPSEEK_REASONING_EFFORT=high
RAG_GENERATION_FAILURE_MODE=error

# Parser / Paddle
RAG_PADDLE_CACHE=artifacts/paddlex
RAG_PADDLE_LAYOUT_MODEL=PP-DocLayoutV3
RAG_PADDLE_OCR_TIER=small
RAG_OCR_MODE=off
RAG_LAYOUT_MODE=required
RAG_RENDER_DPI=168

# API / storage / behavior
RAG_STORAGE_DIR=storage
RAG_API_PREFIX=/api/rag
RAG_API_KEY=
RAG_UPLOAD_MAX_BYTES=104857600
RAG_QUERY_TOP_K_DEFAULT=8
RAG_QUERY_TOP_K_MAX=50
RAG_CONTEXT_TOP_N=4
RAG_INGEST_CONCURRENCY=1
RAG_RETAIN_SUPERSEDED_VECTORS=true
RAG_LOG_LEVEL=INFO


