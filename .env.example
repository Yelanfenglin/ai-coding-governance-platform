# 复制为 .env 后填写。docker compose 会自动读取根目录 .env。
#
#   cp .env.example .env
#   编辑 POSTGRES_PASSWORD
#   docker compose up -d --build
#
# 注意：.env 已在 .gitignore 中，不会被提交。

# 本栈自带的 PostgreSQL（映射到宿主机 127.0.0.1:5433，避开本机 5432）
POSTGRES_PASSWORD=change-me

# 规格检索：embedding / rerank 供应商
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=1024
RAG_DASHSCOPE_API_KEY=
RAG_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# Agent 运行时：模型访问
DEEPSEEK_API_KEY=
