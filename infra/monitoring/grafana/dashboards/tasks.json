        }
      }
    },
    {
      "id": 12,
      "title": "运行记录 · 可展开 trace_id 定位 Phoenix",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "logs"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"embedded-operations\",service=\"embedded-agent\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "title": "依赖熔断状态",
      "description": "0 正常、1 熔断、2 半开探测。冷却结束后由下一次请求触发探测；没有新请求时不会自动恢复。",
      "type": "state-timeline",
      "datasource": {"type": "prometheus", "uid": "metrics"},
      "gridPos": {"x": 0, "y": 47, "w": 8, "h": 8},
      "targets": [{
        "refId": "A", "expr": "agent_circuit_state", "legendFormat": "{{dependency}}",
        "datasource": {"type": "prometheus", "uid": "metrics"}
      }],
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无依赖调用",
          "mappings": [{"type": "value", "options": {
            "0": {"text": "正常", "color": "green"},
            "1": {"text": "熔断", "color": "red"},
            "2": {"text": "探测", "color": "orange"}
          }}]
        },
        "overrides": []
      },
      "options": {"mergeValues": true, "showValue": "auto", "rowHeight": 0.8,
                  "tooltip": {"mode": "single"}}
    },
    {
      "id": 14,
      "title": "熔断拒绝数 · 当前进程累计",
      "description": "被熔断拦下、未发出网络请求的调用次数。进程重启后清零；没有记录时不伪造业务流量。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "metrics"},
      "gridPos": {"x": 8, "y": 47, "w": 8, "h": 8},
      "targets": [{
        "refId": "A", "expr": "agent_circuit_rejected_total", "legendFormat": "{{dependency}}",
        "datasource": {"type": "prometheus", "uid": "metrics"}
      }],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0,
        "min": 0, "noValue": "暂无拒绝记录"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"},
                  "tooltip": {"mode": "multi"}}
    },
    {
      "id": 15,
      "title": "重试恢复率 · 当前进程累计",
      "description": "进入过重试的逻辑请求：recovered / (recovered + failed)。取消单列且不进分母；没有已结束样本时显示无数据，不显示 0% 或 100%。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "metrics"},
      "gridPos": {"x": 16, "y": 47, "w": 8, "h": 8},
      "targets": [{
        "refId": "A",
        "expr": "(sum by (dependency) (agent_retry_outcomes_total{outcome=\"recovered\"}) or on (dependency) (0 * sum by (dependency) (agent_retry_outcomes_total{outcome=~\"recovered|failed\"}))) / on (dependency) (sum by (dependency) (agent_retry_outcomes_total{outcome=~\"recovered|failed\"}) > 0)",
        "legendFormat": "{{dependency}}",
        "datasource": {"type": "prometheus", "uid": "metrics"}
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
        "noValue": "暂无已结束的重试请求"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"},
                  "tooltip": {"mode": "multi"}}
    }
  ],
