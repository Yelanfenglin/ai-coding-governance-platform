    {
      "id": 10,
      "title": "重试与压缩",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_model_retries_total[$__range]))",
          "legendFormat": "重试",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        },
        {
          "refId": "B",
          "expr": "increase(agent_context_compactions_total[$__range])",
          "legendFormat": "压缩",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
