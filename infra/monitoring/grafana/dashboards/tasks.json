    },
    {
      "id": 9,
      "title": "工具结果",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(tool,outcome)(increase(agent_tool_calls_total[$__range]))",
          "legendFormat": "{{tool}} / {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        }
