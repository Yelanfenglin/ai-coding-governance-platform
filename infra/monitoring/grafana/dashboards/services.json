    {
      "id": 8,
      "title": "PG SQL 健康",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_dependency_ready{dependency=\"postgres\"}",
          "legendFormat": "PG SQL 健康",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无采样",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "PG 深度采集",
      "type": "stat",
      "description": "同时检查 HTTP、数据库连接和 SQL 采集结果；采集故障不等于业务库宕机。",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 4,
        "y": 24,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"postgres\"} * pg_up{job=\"postgres\"} * (1-pg_exporter_last_scrape_error{job=\"postgres\"})",
          "legendFormat": "PG 深度采集",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无采样",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "未采集",
                  "color": "grey"
                },
                "1": {
                  "text": "采集中",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
