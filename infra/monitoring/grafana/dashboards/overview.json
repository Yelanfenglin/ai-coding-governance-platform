{
  "uid": "embedded-overview",
  "title": "嵌入式助手 · 系统运行总览",
  "description": "入口、依赖、负载和告警。无采样不等于健康。",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "embedded-assistant",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "title": "运行说明",
      "options": {
        "mode": "markdown",
        "content": "**LOCAL OPERATIONS**　15 秒采集 / 指标最长 15 天或 2GB，日志目标保留 15 天\n\n运行结束、宿主检查通过是两个指标。PostgreSQL 深度采集使用独立 pg_monitor 账号；这里的数据库健康由端口探测和 RAG 的 SELECT 1 独立检查。"
      }
    },
    {
      "id": 2,
      "title": "Agent 可用",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{service=\"agent\"}",
          "legendFormat": "Agent 可用",
          "datasource": {
            "type": "prometheus",
            "uid": "metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无采样",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
